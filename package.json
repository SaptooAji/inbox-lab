{
  "name": "inbox-lab",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "predev": "npm run emails:build",
    "build": "npm run emails:build && next build",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "arch:check": "depcruise src --config .dependency-cruiser.cjs",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "test:watch": "vitest",
    "format": "prettier --write . --log-level warn",
    "test": "vitest run --reporter=dot",
    "test:coverage": "vitest run --coverage --reporter=dot --coverage.reporter=text-summary",
    "verify": "npm run format:check && npm run typecheck && npm run lint && npm run arch:check && npm run test:coverage",
    "emails:build": "tsx emails/build/cli.ts",
    "test:e2e": "playwright test"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,mjs,cjs,json,md,css}": "prettier --write"
  },
  "dependencies": {
    "next": "16.3.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^24.19.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.2",
    "cheerio": "^1.2.0",
    "dependency-cruiser": "^18.4.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "html-to-text": "^10.0.1",
    "husky": "^9.1.7",
    "juice": "^12.2.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
